{"entity":{"addresses":[{"city":null,"country":"Sudan","country_iso2":"SD","postal_code":null,"raw":"Sudan","region":null,"street":null}],"content_hash":"9dd02f3ad89d06d28ad209ff64056e61f3868541be7b265a75b33f8da752586d","dates_of_birth":[],"delisted_on":null,"entity_type":"individual","gender":"female","id":"THEUKLIST:SUD0067","identifications":[],"last_updated_on":"2026-10-26","list":"THEUKLIST","listed_on":"2026-10-26","measures":["Asset freeze","Director Disqualification Sanction","Travel Ban"],"names":[{"language":null,"normalized":"khademallah khashmin herika","publisher_reference":null,"script":null,"strength":null,"type":"primary","value":"Khademallah Khashmin HERIKA"},{"language":null,"normalized":"khademallah khashmin herika","publisher_reference":null,"script":null,"strength":null,"type":"variation","value":"Khademallah Khashmin HERIKA"},{"language":null,"normalized":"shiraz khalid","publisher_reference":null,"script":null,"strength":null,"type":"alias","value":"Shiraz KHALID"}],"nationalities":[{"iso2":"SD","raw":"Sudan"}],"places_of_birth":[],"positions":["RSF Major and Commander of the female element of the RSF"],"programmes":["The Sudan (Sanctions) (EU Exit) Regulations 2020"],"publisher_reference":"SUD0067","references":[],"remarks":"The Secretary of State has reasonable grounds to suspect that Khademallah Khashmin Herika is an involved person under the Sudan (Sanctions) (EU Exit) Regulations 2020 as she is or has been involved in a relevant activity, namely promoting the commission of violations of international humanitarian law in Sudan. As Major Commander of the “Female Element” of the Rapid Support Forces, she has promoted rape and other forms of sexual and gender-based violence in El Fasher and Garni.","source":{"list":"THEUKLIST","url":"https://www.gov.uk/government/publications/the-uk-sanctions-list"},"titles":["Major"]},"id":"THEUKLIST:SUD0067","list":"THEUKLIST","op":"added","previous_content_hash":null}
