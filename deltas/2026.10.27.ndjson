{"entity":{"addresses":[{"city":null,"country":"Sudan","country_iso2":"SD","postal_code":null,"raw":"Sudan","region":null,"street":null}],"content_hash":"8c4adfe83b71018c0948efcb49ba7ace9249b618fac2579b71fed56485b04f7d","dates_of_birth":[],"delisted_on":null,"entity_type":"individual","gender":"male","id":"THEUKLIST:SUD0069","identifications":[],"last_updated_on":"2026-10-26","list":"THEUKLIST","listed_on":"2026-10-26","measures":["Asset freeze","Director Disqualification Sanction","Travel Ban"],"names":[{"language":null,"normalized":"abdelbagi dahab talbo","publisher_reference":null,"script":null,"strength":null,"type":"primary","value":"Abdelbagi Dahab TALBO"}],"nationalities":[],"places_of_birth":[],"positions":[],"programmes":["The Sudan (Sanctions) (EU Exit) Regulations 2020"],"publisher_reference":"SUD0069","references":[],"remarks":"The Secretary of State has reasonable grounds to suspect that Abdelbagi Dahab TALBO is an involved person under the Sudan (Sanctions) (EU Exit) Regulations 2020 because is or has been involved in a relevant activity, namely he is responsible for or provided support for the commission of violations of international humanitarian law in Sudan, including rape and other forms of sexual and gender-based violence. He is a Colonel in the Rapid Support Forces who was present at the “takeover” of Zamzam Internally Displaced Persons Camp in April 2025 where there were numerous accounts of conflict-related sexual violence perpetrated by members of the Rapid Support Forces.","source":{"list":"THEUKLIST","url":"https://www.gov.uk/government/publications/the-uk-sanctions-list"},"titles":["Colonel"]},"id":"THEUKLIST:SUD0069","list":"THEUKLIST","op":"added","previous_content_hash":null}
