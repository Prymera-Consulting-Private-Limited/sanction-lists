{"entity":{"addresses":[{"city":null,"country":"Sudan","country_iso2":"SD","postal_code":null,"raw":"Sudan","region":null,"street":null}],"content_hash":"2d6dc7b4feeadb1e34ccd92fc9944a01168460635a1ac016f4e5796e6b580e23","dates_of_birth":[],"delisted_on":null,"entity_type":"individual","gender":null,"id":"THEUKLIST:SUD0071","identifications":[],"last_updated_on":"2026-10-26","list":"THEUKLIST","listed_on":"2026-10-26","measures":["Asset freeze","Director Disqualification Sanction","Travel Ban"],"names":[{"language":null,"normalized":"al nour ahmed adam","publisher_reference":null,"script":null,"strength":null,"type":"primary","value":"Al-Nour Ahmed ADAM"},{"language":null,"normalized":"al guba","publisher_reference":null,"script":null,"strength":null,"type":"alias","value":"AL-GUBA"},{"language":null,"normalized":"al qubba","publisher_reference":null,"script":null,"strength":null,"type":"alias","value":"AL-QUBBA"},{"language":null,"normalized":"alnwr ahmd adm","publisher_reference":null,"script":"Arabic","strength":null,"type":"original_script","value":"النور أحمد آدم،"}],"nationalities":[],"places_of_birth":[],"positions":[],"programmes":["The Sudan (Sanctions) (EU Exit) Regulations 2020"],"publisher_reference":"SUD0071","references":[],"remarks":"The Secretary of State has reasonable grounds to suspect Al-Nour Ahmed ADAM is an involved person under the Sudan (Sanctions) (EU Exit) Regulations 2020 because he has been involved in a relevant activity, namely he was responsible for the commission of violations of international humanitarian law in Sudan, including violence against persons on the basis of their ethnicity and the deliberate targeting of civilians. As a Major General in the Rapid Support Forces, he played a commanding role issuing direct orders during the “takeover” of El Fasher in October 2025. He has since defected to the Sudanese Armed Forces.","source":{"list":"THEUKLIST","url":"https://www.gov.uk/government/publications/the-uk-sanctions-list"},"titles":["Major General"]},"id":"THEUKLIST:SUD0071","list":"THEUKLIST","op":"added","previous_content_hash":null}
